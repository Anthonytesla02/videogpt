# Server Configuration
PORT=3001
NODE_ENV=development

# API Keys (required)
GEMINI_API_KEY=your_google_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# File Paths
UPLOAD_DIR=./uploads
VIDEO_DIR=./videos
TEMP_DIR=./temp
MAX_FILE_AGE=86400 # 24 hours in seconds

# Rate Limiting
RATE_LIMIT_WINDOW=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX=10 # max requests per window

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg # only needed if ffmpeg is not in PATH

# Database (optional - for future use)
# DATABASE_URL=postgresql://username:password@localhost:5432/aivideogen

# Redis (optional - for caching and job queues)
# REDIS_URL=redis://localhost:6379

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here